{
  "$schema": "https://railway.com/railway.schema.json",

  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/Dockerfile",
    "buildEnvironment": "V3"
  },

  "deploy": {
    "runtime": "V2",
    "numReplicas": 1,

    "startCommand": "./start.sh",

    "sleepApplication": false,

    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,

    "multiRegionConfig": {
      "ams": {
        "numReplicas": 1
      }
    }
  }
}