# Keep real tokens only in .env. Never commit or send that file.
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
# Optional: a development server ID. Slash commands appear there immediately.
# When omitted, commands are synced globally and Discord may take time to show them.
DISCORD_GUILD_ID=

# Public source settings (not secrets)
WIKI_BASE_URL=https://castopia.site
WIKI_MAX_CONCURRENCY=2
WIKI_TIMEOUT=45
# Identify the bot and provide an owner contact or project URL when deploying.
WIKI_USER_AGENT=CastopiaBot/2.0 (+https://castopia.site)
LOG_LEVEL=INFO

# FamiliarBot (wiki moderator). Password stays in Railway env, never in git.
FAMILIARBOT_ENABLED=true
FAMILIARBOT_DRY_RUN=false
WIKI_USERNAME=FamiliarBot
WIKI_PASSWORD=
# Optional: paste techaro.lol-anubis-auth if the host is not allowlisted.
WIKI_ANUBIS_COOKIE=
